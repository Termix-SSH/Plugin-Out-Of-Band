{
  "$schema": "https://raw.githubusercontent.com/Termix-SSH/Termix/main/scripts/authz/authz.schema.json",
  "seed": [
    {
      "as": "admin",
      "method": "POST",
      "path": "/plugin-api/out-of-band/devices",
      "body": {
        "name": "authz-own-bmc",
        "driver": "redfish",
        "address": "127.0.0.1",
        "hostId": "{{host}}",
        "options": {
          "scheme": "https"
        },
        "credentials": {
          "username": "root",
          "password": "authz-pass"
        }
      },
      "capture": {
        "out-of-band.devices": "device.id"
      }
    }
  ],
  "routes": {
    "GET /plugin-api/out-of-band/devices": {
      "access": "user",
      "resource": {
        "kind": "host",
        "min": "connect",
        "key": "hostId"
      },
      "filtered": true,
      "note": "Lists only what the caller may see"
    },
    "POST /plugin-api/out-of-band/devices": {
      "access": "user",
      "resource": {
        "kind": "host",
        "min": "connect",
        "key": "hostId"
      }
    },
    "DELETE /plugin-api/out-of-band/devices/:id": {
      "access": "user",
      "destructive": true
    },
    "PUT /plugin-api/out-of-band/devices/:id": {
      "access": "user",
      "resource": {
        "kind": "host",
        "min": "edit",
        "fixture": "out-of-band.devices"
      },
      "params": {
        "id": "out-of-band.devices"
      },
      "note": "A device follows the host it is linked to"
    },
    "POST /plugin-api/out-of-band/devices/:id/boot": {
      "access": "user",
      "resource": {
        "kind": "host",
        "min": "connect",
        "fixture": "out-of-band.devices"
      },
      "params": {
        "id": "out-of-band.devices"
      },
      "note": "A device follows the host it is linked to"
    },
    "DELETE /plugin-api/out-of-band/devices/:id/log": {
      "access": "user",
      "resource": {
        "kind": "host",
        "min": "edit",
        "fixture": "out-of-band.devices"
      },
      "params": {
        "id": "out-of-band.devices"
      },
      "destructive": true,
      "note": "A device follows the host it is linked to"
    },
    "GET /plugin-api/out-of-band/devices/:id/log": {
      "access": "user",
      "resource": {
        "kind": "host",
        "min": "connect",
        "fixture": "out-of-band.devices"
      },
      "params": {
        "id": "out-of-band.devices"
      },
      "note": "A device follows the host it is linked to"
    },
    "GET /plugin-api/out-of-band/devices/:id/media": {
      "access": "user",
      "resource": {
        "kind": "host",
        "min": "connect",
        "fixture": "out-of-band.devices"
      },
      "params": {
        "id": "out-of-band.devices"
      },
      "note": "A device follows the host it is linked to",
      "permission": "out-of-band.media"
    },
    "POST /plugin-api/out-of-band/devices/:id/media/eject": {
      "access": "user",
      "resource": {
        "kind": "host",
        "min": "connect",
        "fixture": "out-of-band.devices"
      },
      "params": {
        "id": "out-of-band.devices"
      },
      "note": "A device follows the host it is linked to"
    },
    "POST /plugin-api/out-of-band/devices/:id/media/mount": {
      "access": "user",
      "resource": {
        "kind": "host",
        "min": "connect",
        "fixture": "out-of-band.devices"
      },
      "params": {
        "id": "out-of-band.devices"
      },
      "note": "A device follows the host it is linked to"
    },
    "POST /plugin-api/out-of-band/devices/:id/poll": {
      "access": "user",
      "resource": {
        "kind": "host",
        "min": "connect",
        "fixture": "out-of-band.devices"
      },
      "params": {
        "id": "out-of-band.devices"
      },
      "note": "A device follows the host it is linked to"
    },
    "POST /plugin-api/out-of-band/devices/:id/power": {
      "access": "user",
      "resource": {
        "kind": "host",
        "min": "connect",
        "fixture": "out-of-band.devices"
      },
      "params": {
        "id": "out-of-band.devices"
      },
      "destructive": true,
      "note": "A device follows the host it is linked to"
    },
    "GET /plugin-api/out-of-band/devices/by-host/:hostId": {
      "access": "user",
      "resource": {
        "kind": "host",
        "min": "connect"
      },
      "filtered": true,
      "note": "Answers no device when the caller cannot see the host"
    },
    "POST /plugin-api/out-of-band/devices/test": {
      "access": "user",
      "resource": {
        "kind": "host",
        "min": "connect",
        "key": "hostId"
      }
    },
    "GET /plugin-api/out-of-band/drivers": {
      "access": "user",
      "permission": "out-of-band.view"
    },
    "WS /plugin-ws/out-of-band/sol": {
      "access": "user",
      "note": "Needs the console permission; the device is checked in the first message",
      "permission": "out-of-band.console"
    }
  }
}
